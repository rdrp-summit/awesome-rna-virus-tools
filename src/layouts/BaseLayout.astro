---
import { GitFork } from "@lucide/astro";
import logoUrl from "../../rdrp_summit.png?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Awesome RNA Virus Tools",
  description = "Curated software, databases, and literature for RNA virus research.",
} = Astro.props;
const base = `${import.meta.env.BASE_URL}/`.replace(/\/{2,}/g, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={logoUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Awesome RNA Virus Tools home">
        <img src={logoUrl} alt="" width="42" height="42" />
        <span>Awesome RNA Virus Tools</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}#catalog`}>Catalog</a>
        <a href={`${base}contribute/`}>Contribute</a>
        <a
          class="icon-link"
          href="https://github.com/rdrp-summit/awesome-rna-virus-tools"
          aria-label="GitHub repository"
          title="GitHub repository"
        >
          <GitFork size={20} aria-hidden="true" />
        </a>
      </nav>
    </header>
    <slot />
    <footer>
      <p>Curated by the RNA virus research community.</p>
      <a href={`${base}contribute/`}>Suggest an entry</a>
    </footer>
  </body>
</html>